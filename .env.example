
# Supabase Configuration
# Copy this file to .env and replace with your actual Supabase credentials
# Get these from: https://app.supabase.com/project/_/settings/api

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# The anon key should be a JWT token starting with "eyJhbGci..."
# Do NOT commit your actual .env file to public repositories

# Mapbox Configuration (Optional)
# Used for address autocomplete, geocoding, and reverse geocoding
# Sign up at https://www.mapbox.com and create a public access token
# Get your token from: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_public_token_here

# App URL (used for short PDF links in emails/SMS)
# Set to your deployed web app base URL + /pdf path
EXPO_PUBLIC_APP_URL=https://bizzypro.app/pdf

# Email Service Configuration (Optional)
# The app uses Mailgun for sending estimate and invoice emails
# Sign up at https://www.mailgun.com and create an API key
# Add the MAILGUN_API_KEY secret to your Supabase project:
# 1. Go to https://app.supabase.com/project/_/settings/functions
# 2. Add a new secret: MAILGUN_API_KEY=your_mailgun_api_key_here
#
# Note: Estimates and invoices will still save without this configured,
# but email sending will not work until the secret is set.
